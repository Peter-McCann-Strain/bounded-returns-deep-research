# Template: copy to `.env` and fill in your own credentials.
# `.env` is gitignored; this template is intentionally public.
#
# You do not need every key. Pick the section matching what you want to run:
#   - API reproduction path (patterns P0-P8, API judges) -> "Generation" + "Judging"
#   - Local/GPU patterns (P9-P17)                        -> "Local models"
#   - Statistics only (papers/.../analysis)              -> nothing; reads data/analysis

# ── Generation ───────────────────────────────────────────────────────────────
# Public default: standard OpenAI API for generation and search.
# These model IDs are release-tested defaults, not a claim about provider-current best models.
# Override them for a paid rerun and record the exact IDs in your summary.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_WEB_SEARCH_TOOL=web_search

# Model routing used by the historical pattern pipelines (deep_research/config.py).
DEFAULT_MODEL=gpt-4o
SEARCH_MODEL=gpt-4o-mini

# ── Judging ──────────────────────────────────────────────────────────────────
OPENAI_JUDGE_MODEL=gpt-5.6-sol
JUDGE_MODEL=gpt-5.2

# Claude judge panel: Anthropic API only.
# These defaults are release-tested judge IDs; check Anthropic before spending.
ANTHROPIC_API_KEY=
ANTHROPIC_OPUS_MODEL=claude-opus-4-8
ANTHROPIC_SONNET_MODEL=claude-sonnet-4-6

# Separate judge endpoint (the study ran judging off the generation capacity pool).
JUDGE_OPENAI_API_KEY=
JUDGE_OPENAI_ENDPOINT=

# ── Optional Azure OpenAI path ───────────────────────────────────────────────
# Use deployment names for generation/judging. The public generation workflow
# expects the OpenAI-compatible v1 Responses API and a deployment entitled for
# the configured hosted web_search tool.
USE_AZURE_OPENAI=false
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_API_VERSION=v1
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_JUDGE_DEPLOYMENT=

# Azure deployment names are provisioning-specific. Set these to the names your
# resource uses; each defaults to the matching model id when unset.
GPT4O_DEPLOYMENT=gpt-4o
JUDGE_GPT4O_DEPLOYMENT=gpt-4o
JUDGE_GPT41_DEPLOYMENT=gpt-4.1

# Separate search endpoint, if search runs on its own capacity.
SEARCH_OPENAI_API_KEY=
SEARCH_OPENAI_ENDPOINT=

# ── Search and data helpers ──────────────────────────────────────────────────
# SEARCH_BACKEND selects the retrieval tool: openai | tavily | bing
SEARCH_BACKEND=openai
TAVILY_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
S2_API_KEY=

# ── Local models (patterns P9-P17, GPU) ──────────────────────────────────────
# Only needed for the local/GPU patterns. Install with: pip install -e ".[local]"
# Fetch weights first: python scripts/download_models.py
DR_LOCAL_LLM=
DR_LOCAL_MODEL=
DR_LOCAL_CONTENT_CAP=
P12_LORA_ADAPTER_PATH=

# ── Paths ────────────────────────────────────────────────────────────────────
# DR_PROJECT_ROOT overrides repository-root detection (deep_research/paths.py).
# Leave unset when running from a checkout or an editable install.
DR_PROJECT_ROOT=
# Relative paths resolve from the project root.
DR_DATA_DIR=data
DR_ARTIFACTS_DIR=artifacts
DR_RESULTS_DIR=results
DR_REPORTS_DIR=reports
DR_CHECKPOINTS_DIR=checkpoints
DR_DOCS_DIR=docs
DR_PAPERS_DIR=papers
DR_PAPER_DIR=papers/paper_a_bounded_returns

# ── Budget guardrails ────────────────────────────────────────────────────────
# Per-call planning values used by `deep-research cost` and `--max-cost-usd`.
# They are estimates only; update them from current provider pricing.
MAX_COST_PER_RUN=
MAX_COST_EVAL_RUN=
DR_COST_OPENAI_GENERATION_USD_PER_CALL=0.20
DR_COST_OPENAI_WEB_SEARCH_USD_PER_CALL=0.01
DR_COST_OPENAI_JUDGE_USD_PER_CALL=0.05
DR_COST_ANTHROPIC_OPUS_JUDGE_USD_PER_CALL=0.30
DR_COST_ANTHROPIC_SONNET_JUDGE_USD_PER_CALL=0.10
